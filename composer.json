{
    "name": "nails/module-data-migration",
    "keywords":
    [],
    "homepage": "https://docs.nailsapp.co.uk/modules/other/data-migration",
    "description": "The Data Migration module provides a framework for structured data migration from external sources into the app.",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require":
    {
        "nails/common": "dev-develop",
        "hellopablo/data-migration": "dev-develop"
    },
    "require-dev":
    {
        "phpunit/phpunit": "9.*",
        "phpstan/phpstan": "1.*"
    },
    "scripts":
    {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon"
    },
    "autoload":
    {
        "psr-4":
        {
            "Nails\\DataMigration\\": "src/"
        }
    },
    "autoload-dev":
    {
        "psr-4":
        {
            "Nails\\DataMigration\\Tests\\": "src/"
        }
    },
    "extra":
    {
        "nails":
        {
            "moduleName": "module-data-migration",
            "type": "module",
            "namespace": "Nails\\DataMigration\\",
            "data":
            {}
        }
    }
}